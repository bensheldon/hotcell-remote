# frozen_string_literal: true

source "https://rubygems.org"

gem "rails", "~> 8.1"
gem "sqlite3"

# The application and the service. The application sends requests with Hot Cell's client; the service's
# gateway is a Rack app on Puma.
group :default, :hotcell do
  gem "hotcell-remote", github: "bensheldon/hotcell-remote"
  gem "puma"
end

# The cell, and the gems that the operations use. Development and test run requests in process, for parity.
group :development, :test, :hotcell do
  gem "hotcell-server"
  gem "image_processing"
  gem "ruby-vips"
end
